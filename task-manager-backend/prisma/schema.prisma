generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  password     String
  refreshToken String?
  tasks        Task[]
}

model Task {
  id     Int     @id @default(autoincrement())
  title  String
  status Boolean @default(false)
  userId Int
  user   User    @relation(fields: [userId], references: [id])
}
